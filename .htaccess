# ============================================================
#  Media Clock — Apache config (Hostinger / SiteGround / any cPanel host)
#  Assumes the site is served from the domain root (public_html).
# ============================================================

Options -Indexes
DirectoryIndex index.php

# ------------------------------------------------------------
#  Pretty URLs:  /about-us/  ->  about-us.php
#  Keeps the URLs the live site already ranks for on Google.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Sub-folder deploys -------------------------------------------
    # Set to the folder the site is served from, trailing slash included.
    # Currently the Bluehost staging path: the site sits in new/ inside a
    # WordPress install, so WordPress keeps its own root .htaccess and this
    # one applies only inside new/.
    # COMMENT THIS LINE OUT when the site moves to the domain root.
    RewriteBase /website_b2369336/new/
    # -----------------------------------------------------------------

    # Let Let's Encrypt / SSL renewal through untouched
    RewriteRule ^\.well-known/ - [L]

    # Force HTTPS (the X-Forwarded-Proto check keeps Cloudflare from looping)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # www -> non-www (the live site is non-www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Shared code is included by the pages, never opened directly
    RewriteRule ^(includes|data)/ - [F,L]

    # /index.php -> ./              (canonical home URL)
    RewriteCond %{THE_REQUEST} \s[^\s?]*/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ ./ [R=301,L]

    # /about-us.php -> /about-us/   (one canonical URL, no duplicate content)
    RewriteCond %{THE_REQUEST} \s[^\s?]*/([^./\s?]+)\.php[\s?] [NC]
    RewriteRule ^([^/.]+)\.php$ $1/ [R=301,L]

    # /about-us -> /about-us/       (keep the trailing slash consistent)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/.]+)$ $1/ [R=301,L]

    # /blog/<slug>/ -> blog-post.php?slug=<slug>   (one article)
    # Must come before the generic rule below, which only handles one segment.
    RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

    # /about-us/ -> about-us.php    (the actual rewrite, no redirect)
    # REQUEST_FILENAME checks keep this working at the root or in a sub-folder;
    # a slug with no matching .php simply falls through to a normal 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/.]+)/$ $1.php [L]
</IfModule>

# Hide dot-files (.git, .gitignore, .env), but not the SSL folder
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# ------------------------------------------------------------
#  404 page — uncomment once 404.php exists
# ------------------------------------------------------------
# ErrorDocument 404 /404.php

# ------------------------------------------------------------
#  Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
        application/javascript application/x-javascript application/json \
        image/svg+xml application/xml
</IfModule>

# ------------------------------------------------------------
#  Browser caching — images and CSS/JS are versioned by deploy, HTML never cached
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
#  Basic security headers
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
