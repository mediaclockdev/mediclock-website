	jQuery( document ).on( 'elementor/popup/show', (event, id, objPopup) => {
	if(objPopup.$element.has(jQuery("#uc_fullscreen_navigation_menu_elementor_bada6ec")).length) uc_fullscreen_navigation_menu_elementor_bada6ec_start();});
});

			
</script>
</body>
</html> 
